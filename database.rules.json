{
  "rules": {
    "$study": {
      "studyInfo": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "participantData": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
